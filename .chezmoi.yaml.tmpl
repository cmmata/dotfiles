{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $githubEmail := promptStringOnce . "githubEmail" "GitHub email address (e.g. 123456+username@users.noreply.github.com)" -}}
{{- $username := promptStringOnce . "username" "User name" -}}
{{- $purpose := promptStringOnce . "purpose" "Purpose of this machine (personal or server)" -}}

data:
    email: {{ $email | quote }}
    githubEmail: {{ $githubEmail | quote }}
    username: {{ $username | quote }}
    purpose: {{ $purpose | quote }}
